{
  "name": "toolmap",
  "version": "0.6.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit --project jsconfig.json",
    "pretest": "npm run verify:build",
    "test": "node --test tests/*.mjs",
    "deploy:cf": "npm run build && npx --yes wrangler@4 deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
